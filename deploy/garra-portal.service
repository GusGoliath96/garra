[Unit]
Description=Garra portal (Next.js) + provisionador de cells OpenClaw
# Sobe depois da rede e do Docker (Postgres e cells são containers com restart unless-stopped).
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm start -- -p 3000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
